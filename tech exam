// b. Function to Find the Top Student
// javascript
function findTopStudent(subject, students) {
  let topStudent = null;
  let highestGrade = -1;

  students.forEach(student => {
    if (student.grades[subject] > highestGrade) {
      highestGrade = student.grades[subject];
      topStudent = student.name;
    }
  });

  return topStudent;
}
