//   2. a. Function to get Subject Averages
// javascript
function getSubjectAverages(students) {
  const subjects = Object.keys(students[0].grades);
  const averages = {};

  subjects.forEach(subject => {
    const total = students.reduce((sum, student) => sum + student.grades[subject], 0);
    averages[subject] = total / students.length;
  });

  return averages;
}

