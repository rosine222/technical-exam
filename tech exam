// c. Function to Add Extra Credit
// javascript
function addExtraCredit(students, points) {
  return students.map(student => {
    const updatedGrades = {};
    for (let subject in student.grades) {
      updatedGrades[subject] = Math.min(student.grades[subject] + points, 100);
    }
    return { ...student, grades: updatedGrades };
  });
}
