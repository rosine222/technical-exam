// A FUNCTION COUNTROLES
function countRoles(users) {
    const roleCounts = { admin: 0, instructor: 0, student: 0 };
    
    for (let user of users) {
        if (user.role === 'admin') {
            roleCounts.admin++;
        } else if (user.role === 'instructor') {
            roleCounts.instructor++;
        } else if (user.role === 'student') {
            roleCounts.student++;
        }
    }

    return roleCounts;
}
